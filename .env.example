# Environment Variables
# Copy this file to .env.local for local development

# API URL - Your Laravel backend URL
NEXT_PUBLIC_API_URL=

# CSRF is optional for token-based API auth. Keep false unless your backend expects stateful CSRF cookies.
NEXT_PUBLIC_ENABLE_CSRF=false

# Server-only secret used by Next.js proxy route for internal storefront endpoints.
# Must match backend INTERNAL_API_SECRET / shop.internal_api_secret.
INTERNAL_API_SECRET=super_secret_key_123

# Stripe Publishable Key (for payment processing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
